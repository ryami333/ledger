{
  "name": "ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "yarn lint:prettier && yarn lint:eslint && yarn lint:typescript && yarn lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lint:typescript": "tsc6",
    "lint:stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "docker compose up -d --wait && yarn db:migrate",
    "db:stop": "docker compose stop",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait && yarn db:migrate && yarn db:seed",
    "db:seed": "cat db/seeds/*.sql | docker compose exec -T db psql -U postgres -v ON_ERROR_STOP=1 --quiet",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrateDatabase.ts",
    "db:diff": "scripts/diff-database.sh",
    "db:test": "scripts/test-database.sh",
    "db:psql": "docker compose exec db psql -U postgres",
    "generate": "docker compose run --rm --quiet-pull types > src/db/database.types.ts && prettier --write src/db/database.types.ts",
    "release": "release-it"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@supabase/pg-delta": "1.0.0-alpha.60",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nitro": "3.0.260610-beta",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "release-it": "^21.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-use-logical": "^2.1.3",
    "stylelint-use-nesting": "^6.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@supabase/postgrest-js": "^2.118.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "~1.7.15",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.82.0",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.6.6"
  }
}
