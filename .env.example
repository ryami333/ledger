# Each secret can also come from a file, for example a Docker secret. Set
# <NAME>_FILE to its path, in place of <NAME>. src/core/env/readSecretFiles.ts
# lists the secrets.

# Web app
APP_URL=http://127.0.0.1:3001
# The locale and the time zone of all dates and amounts, on the server and in
# the browser (PLAN.md, D4 and D11).
APP_LOCALE=en-IE
APP_TIME_ZONE=Europe/Berlin

# PostgREST of the local stack (compose.yaml). The JWT secret is the same as
# PGRST_JWT_SECRET there.
POSTGREST_URL=http://127.0.0.1:54331
POSTGREST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# A direct session connection to Postgres, as the owner role. better-auth and
# the migration script use it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Sign-in with better-auth and Pocket ID (see PLAN.md, D3). Make the secret
# with `openssl rand -hex 32`. Register the callback URL
# http://127.0.0.1:3001/api/auth/callback/pocket-id in the OIDC client of
# Pocket ID.
BETTER_AUTH_SECRET=
POCKET_ID_ISSUER=
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
